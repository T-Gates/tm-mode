[
  {
    "event": "SessionStart",
    "script": "session-start.py",
    "timeout": 60,
    "mode": "on",
    "enforcement": "advisory",
    "_timeout_unit": "seconds",
    "_timeout_note": "SessionStart hard budget 50s(동기화 cutoff 40s + context reserve 10s). main sync와 upstream fetch가 absolute deadline을 공유하고 optional Git 장식은 예산 소진 시 생략해 runner 60s kill 전에 context JSON을 출력한다."
  },
  {
    "event": "UserPromptSubmit",
    "script": "session-log-remind.py",
    "timeout": 2,
    "mode": "on",
    "enforcement": "advisory",
    "_timeout_unit": "seconds"
  },
  {
    "event": "PostToolUse",
    "match": { "action": "file_edit" },
    "script": "auto-commit.py",
    "timeout": 70,
    "fallback": "runtime",
    "enforcement": "block",
    "_timeout_unit": "seconds",
    "_timeout_note": "#128 scoped commit + main 즉시 동기화. 첫 index.lock 실패는 1초 뒤 한 번만 재시도하며 runner 70s kill 전에 last-sync-error를 기록한다."
  },
  {
    "event": "PostToolUseFailure",
    "match": { "action": "file_edit" },
    "script": "edit-lease-cleanup.py",
    "timeout": 2,
    "mode": "on",
    "enforcement": "advisory",
    "_timeout_unit": "seconds",
    "_note": "Claude exact failure lifecycle cleanup. Codex 0.144.4 does not expose PostToolUseFailure and explicitly maps this event to null."
  },
  {
    "event": "PreToolUse",
    "match": { "mcp": { "server": "linear", "tool": "create_issue" } },
    "script": "confirm-action.py",
    "args": "teammode-linear-create-allow",
    "timeout": 2,
    "fallback": "runtime",
    "enforcement": "block",
    "strict": true,
    "_timeout_unit": "seconds"
  }
]
